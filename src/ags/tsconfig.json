{
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "ags/gtk4",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "paths": {
      "ags": [
        "./types/ags"
      ],
      "ags/*": [
        "./types/ags/*"
      ]
    },
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2020"
  },
  "include": [
    "./**/*.tsx",
    "./**/*.ts",
    "./env.d.ts"
  ]
}