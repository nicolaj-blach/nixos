#!/usr/bin/env bash
# Power menu using fsel dmenu mode
# This script must be run inside a terminal

choice=$(printf "poweroff\nreboot\nlock\nscreensaver\nswitch" | fsel --dmenu)

case "$choice" in
    lock)
        hyprlock-wrapper
        ;;
    screensaver)
        $TERMINAL --title screensaver -e screensaver
        ;;
    switch)
        $TERMINAL --title terminal-float -e nixs
        ;;
    reboot)
        systemctl reboot
        ;;
    poweroff)
        systemctl poweroff
        ;;
esac
