#!/usr/bin/env bash
# Notification history using Walker dmenu mode
# Select a notification to restore it

# Parse mako history into menu format
notifications=$(makoctl history 2>/dev/null | awk '
    /^Notification [0-9]+:/ {
        if (title != "") print icon "  " title
        title = substr($0, index($0, ":") + 2)
        icon = "\uf0f3"
    }
    END {
        if (title != "") print icon "  " title
    }
')

if [[ -z "$notifications" ]]; then
    notify-send "No notifications" "History is empty"
    exit 0
fi

# Add restore option at the top
menu=$(echo -e "\uf01e  restore last\n$notifications")

choice=$(echo "$menu" | walker -d -p "notifications")
[[ -z "$choice" ]] && exit 0

if [[ "$choice" == *"restore last"* ]]; then
    makoctl restore
fi
