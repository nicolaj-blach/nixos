#!/usr/bin/env bash
# Emoji picker using bemoji + fsel
# This script must be run inside a terminal
# Copies emoji to clipboard

export BEMOJI_PICKER_CMD="fsel --dmenu"
terminal_address=$(hyprctl activewindow -j | jq -r '.address')
bemoji -c
if [ -n "$terminal_address" ] && [ "$terminal_address" != "null" ]; then
  hyprctl dispatch closewindow "address:$terminal_address"
fi
