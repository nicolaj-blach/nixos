#!/usr/bin/env bash
# Generate SwayOSD style.css from tinty base16 palette.
# Called as a tinty hook — palette is available via $TINTY_SCHEME_PALETTE_* env vars.

B00="${TINTY_SCHEME_PALETTE_BASE00_HEX_R}${TINTY_SCHEME_PALETTE_BASE00_HEX_G}${TINTY_SCHEME_PALETTE_BASE00_HEX_B}"
B02="${TINTY_SCHEME_PALETTE_BASE02_HEX_R}${TINTY_SCHEME_PALETTE_BASE02_HEX_G}${TINTY_SCHEME_PALETTE_BASE02_HEX_B}"
B05="${TINTY_SCHEME_PALETTE_BASE05_HEX_R}${TINTY_SCHEME_PALETTE_BASE05_HEX_G}${TINTY_SCHEME_PALETTE_BASE05_HEX_B}"
B0D="${TINTY_SCHEME_PALETTE_BASE0D_HEX_R}${TINTY_SCHEME_PALETTE_BASE0D_HEX_G}${TINTY_SCHEME_PALETTE_BASE0D_HEX_B}"
B0E="${TINTY_SCHEME_PALETTE_BASE0E_HEX_R}${TINTY_SCHEME_PALETTE_BASE0E_HEX_G}${TINTY_SCHEME_PALETTE_BASE0E_HEX_B}"

SWAYOSD_STYLE="$HOME/.config/swayosd/style.css"
mkdir -p "$(dirname "$SWAYOSD_STYLE")"
[[ -L "$SWAYOSD_STYLE" ]] && rm "$SWAYOSD_STYLE"

cat > "$SWAYOSD_STYLE" << EOF
/* Auto-generated by tinty-swayosd-hook — do not edit */

window {
  background: transparent;
}

#osd {
  background-color: alpha(#${B00}, 0.9);
  border: 1px solid #${B02};
  border-radius: 0;
  padding: 16px 24px;
}

#osd image {
  color: #${B05};
  -gtk-icon-style: symbolic;
}

#osd #container {
  margin: 0;
}

#osd progressbar {
  min-height: 8px;
  border-radius: 0;
}

#osd progressbar trough {
  background-color: #${B02};
  border-radius: 0;
  min-height: 8px;
}

#osd progressbar progress {
  background-color: #${B0D};
  border-radius: 0;
  min-height: 8px;
}

#osd label {
  color: #${B05};
  font-family: "JetBrainsMono Nerd Font";
  font-size: 14px;
}

#osd .muted progressbar progress {
  background-color: #${B02};
}

#osd .muted image {
  color: #${B02};
}

#osd .capslock-on image {
  color: #${B0E};
}

#osd .capslock-off image {
  color: #${B02};
}
EOF
