#!/usr/bin/env bash
# Yazi file picker: opens files or directories picked from a floating yazi TUI.
# Launched via SUPER+SHIFT+E.
#
# Uses --chooser-file so yazi writes the picked path and exits on 'open'.
# Uses --cwd-file so quitting with 'q' opens a terminal in the last directory.
#
# - Enter on any item: yazi writes path to chooser-file and exits
#   - Text/code file: opens in $EDITOR in a new terminal
#   - Other file (image, pdf, etc.): opens with xdg-open
#   - Directory: opens terminal there
# - l/h to navigate directories (standard yazi nav)
# - q to quit: open terminal in last directory

chooser=$(mktemp)
cwdfile=$(mktemp)

YAZI_CONFIG_HOME=~/.config/yazi-picker yazi --chooser-file="$chooser" --cwd-file="$cwdfile"

# Read results before cleanup
chosen=""
[ -s "$chooser" ] && chosen=$(cat "$chooser")
cwd=""
[ -s "$cwdfile" ] && cwd=$(cat "$cwdfile")
rm -f "$chooser" "$cwdfile"

# Check if a file's xdg handler is terminal-based (needs a terminal to run).
# Returns 0 if the .desktop file has Terminal=true, 1 otherwise.
needs_terminal() {
  local mime handler desktop
  mime=$(xdg-mime query filetype "$1" 2>/dev/null) || return 1
  handler=$(xdg-mime query default "$mime" 2>/dev/null) || return 1
  [ -z "$handler" ] && return 1
  for dir in ~/.local/share/applications /usr/share/applications /run/current-system/sw/share/applications; do
    desktop="$dir/$handler"
    if [ -f "$desktop" ]; then
      grep -qi '^Terminal=true' "$desktop" && return 0
      return 1
    fi
  done
  return 1
}

# Use hyprctl dispatch exec to spawn independently of this terminal
if [ -n "$chosen" ]; then
  while IFS= read -r selected; do
    [ -z "$selected" ] && continue
    if [ -d "$selected" ]; then
      hyprctl dispatch exec "[silent] ghostty --working-directory='$selected'"
    elif needs_terminal "$selected"; then
      hyprctl dispatch exec "[silent] ghostty -e ${EDITOR:-nvim} '$selected'"
    else
      hyprctl dispatch exec "[silent] xdg-open '$selected'"
    fi
  done <<<"$chosen"
elif [ -d "$cwd" ]; then
  hyprctl dispatch exec "[silent] ghostty --working-directory='$cwd'"
fi
