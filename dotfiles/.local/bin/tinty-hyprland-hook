#!/usr/bin/env bash
# Generate Hyprland colors.conf and hyprlock.conf from tinty base16 palette.
# Called as a tinty hook — palette is available via $TINTY_SCHEME_PALETTE_* env vars.

# base16 mapping:
#   base00 = background        -> panel bg, shadow
#   base01 = lighter background -> inactive border
#   base02 = selection         -> borders, separator, muted elements
#   base03 = comments          -> date, prompt label, status line
#   base05 = foreground        -> time, main text
#   base08 = red               -> error text, password dots, low battery
#   base0B = green             -> battery icon
#   base0C = cyan              -> wifi icon
#   base0D = blue/accent       -> active border primary, bluetooth icon
#   base0E = purple/accent     -> active border secondary, title, volume icon

B00="${TINTY_SCHEME_PALETTE_BASE00_HEX_R}${TINTY_SCHEME_PALETTE_BASE00_HEX_G}${TINTY_SCHEME_PALETTE_BASE00_HEX_B}"
B01="${TINTY_SCHEME_PALETTE_BASE01_HEX_R}${TINTY_SCHEME_PALETTE_BASE01_HEX_G}${TINTY_SCHEME_PALETTE_BASE01_HEX_B}"
B02="${TINTY_SCHEME_PALETTE_BASE02_HEX_R}${TINTY_SCHEME_PALETTE_BASE02_HEX_G}${TINTY_SCHEME_PALETTE_BASE02_HEX_B}"
B03="${TINTY_SCHEME_PALETTE_BASE03_HEX_R}${TINTY_SCHEME_PALETTE_BASE03_HEX_G}${TINTY_SCHEME_PALETTE_BASE03_HEX_B}"
B05="${TINTY_SCHEME_PALETTE_BASE05_HEX_R}${TINTY_SCHEME_PALETTE_BASE05_HEX_G}${TINTY_SCHEME_PALETTE_BASE05_HEX_B}"
B08="${TINTY_SCHEME_PALETTE_BASE08_HEX_R}${TINTY_SCHEME_PALETTE_BASE08_HEX_G}${TINTY_SCHEME_PALETTE_BASE08_HEX_B}"
B0B="${TINTY_SCHEME_PALETTE_BASE0B_HEX_R}${TINTY_SCHEME_PALETTE_BASE0B_HEX_G}${TINTY_SCHEME_PALETTE_BASE0B_HEX_B}"
B0C="${TINTY_SCHEME_PALETTE_BASE0C_HEX_R}${TINTY_SCHEME_PALETTE_BASE0C_HEX_G}${TINTY_SCHEME_PALETTE_BASE0C_HEX_B}"
B0D="${TINTY_SCHEME_PALETTE_BASE0D_HEX_R}${TINTY_SCHEME_PALETTE_BASE0D_HEX_G}${TINTY_SCHEME_PALETTE_BASE0D_HEX_B}"
B0E="${TINTY_SCHEME_PALETTE_BASE0E_HEX_R}${TINTY_SCHEME_PALETTE_BASE0E_HEX_G}${TINTY_SCHEME_PALETTE_BASE0E_HEX_B}"

# --- Hyprland colors.conf ---
COLORS_FILE="$HOME/.config/hypr/colors.conf"
[[ -L "$COLORS_FILE" ]] && rm "$COLORS_FILE"

cat > "$COLORS_FILE" << EOF
# Auto-generated by tinty-hyprland-hook — do not edit
\$active_border_1 = rgb(${B0D})
\$active_border_2 = rgb(${B0E})
\$inactive_border = rgb(${B01})
\$shadow_color = rgb(${B00})
EOF

# --- hyprlock.conf ---
LOCK_FILE="$HOME/.config/hypr/hyprlock.conf"
[[ -L "$LOCK_FILE" ]] && rm "$LOCK_FILE"

cat > "$LOCK_FILE" << EOF
# Auto-generated by tinty-hyprland-hook — do not edit
# https://wiki.hypr.land/Hypr-Ecosystem/hyprlock/
# Modern TUI-style lock screen

general {
    grace = 0
    no_fade_in = true
    no_fade_out = true
    immediate_render = true
    hide_cursor = true
}

# Blurred screenshot of current desktop
background {
    monitor =
    path = screenshot
    blur_passes = 3
    blur_size = 6
    noise = 0.01
    brightness = 0.8
}

# Main panel -- sharp corners, single-line border
shape {
    monitor =
    size = 1200, 460
    color = rgba(${B00}ee)
    rounding = 0
    border_size = 1
    border_color = rgb(${B02})
    position = 0, 0
    halign = center
    valign = center
}

# Title bar text
label {
    monitor =
    text = [ locked ]
    color = rgb(${B0E})
    font_size = 14
    font_family = JetBrainsMono Nerd Font Bold
    position = 0, 205
    halign = center
    valign = center
}

# Time
label {
    monitor =
    text = cmd[update:1000] date +'%H:%M:%S'
    color = rgb(${B05})
    font_size = 80
    font_family = JetBrainsMono Nerd Font Bold
    position = 0, 120
    halign = center
    valign = center
}

# Date
label {
    monitor =
    text = cmd[update:60000] date +'%A, %B %d'
    color = rgb(${B03})
    font_size = 18
    font_family = JetBrainsMono Nerd Font
    position = 0, 40
    halign = center
    valign = center
}

# Separator
shape {
    monitor =
    size = 1120, 1
    color = rgb(${B02})
    rounding = 0
    border_size = 0
    position = 0, -10
    halign = center
    valign = center
}

# Password prompt label
label {
    monitor =
    text = password >
    color = rgb(${B03})
    font_size = 16
    font_family = JetBrainsMono Nerd Font
    position = -460, -80
    halign = center
    valign = center
}

# Input field border -- sharp corners
shape {
    monitor =
    size = 910, 60
    color = rgba(${B00}00)
    rounding = 0
    border_size = 1
    border_color = rgb(${B02})
    position = 85, -80
    halign = center
    valign = center
}

# Password input
input-field {
    monitor =
    size = 890, 50
    outline_thickness = 0
    dots_size = 0.4
    dots_spacing = 0.3
    dots_center = false
    dots_rounding = 0
    dots_text_format = *
    outer_color = rgba(00000000)
    inner_color = rgba(${B00}00)
    font_color = rgb(${B08})
    font_size = 18
    font_family = JetBrainsMono Nerd Font
    fade_on_empty = false
    placeholder_text =
    hide_input = false
    rounding = 0
    check_color = rgba(00000000)
    fail_color = rgba(00000000)
    fail_text = <span font_family="JetBrainsMono Nerd Font" font_size="16pt" foreground="##${B08}">error: authentication failed (\$ATTEMPTS)</span>
    fail_timeout = 2000
    fail_transition = 0
    dots_fade_time = 0
    fade_timeout = 0
    position = 85, -80
    halign = center
    valign = center
}

# Status line
label {
    monitor =
    text = cmd[update:1000] echo "\$(whoami)@\$(hostname)"
    color = rgb(${B02})
    font_size = 12
    font_family = JetBrainsMono Nerd Font
    position = 0, -195
    halign = center
    valign = center
}
EOF

# --- AGS bar colors.css ---
AGS_COLORS="$HOME/.config/ags/colors.css"
mkdir -p "$(dirname "$AGS_COLORS")"
[[ -L "$AGS_COLORS" ]] && rm "$AGS_COLORS"

cat > "$AGS_COLORS" << EOF
@define-color bar_bg #${B00};
@define-color bar_fg #${B05};
@define-color bar_border #${B02};
@define-color bar_accent #${B0D};
@define-color bar_accent2 #${B0E};
@define-color bar_muted #${B03};
@define-color bar_red #${B08};
@define-color bar_green #${B0B};
@define-color bar_cyan #${B0C};
EOF

# --- Mako config ---
MAKO_FILE="$HOME/.config/mako/config"
mkdir -p "$(dirname "$MAKO_FILE")"
[[ -L "$MAKO_FILE" ]] && rm "$MAKO_FILE"

cat > "$MAKO_FILE" << EOF
# Auto-generated by tinty-hyprland-hook — do not edit
# Mako notification daemon config

# Layout
max-visible=3
sort=-time
layer=overlay
anchor=top-right
margin=20,20,0,0

# Appearance
font=JetBrainsMono Nerd Font 11
width=400
height=150
padding=16
border-size=1
border-radius=0
background-color=#${B00}ee
text-color=#${B05}
border-color=#${B02}
progress-color=over #${B0D}


# Behavior
default-timeout=5000
ignore-timeout=0
icons=1
max-icon-size=48
markup=1
actions=1

# Urgency overrides
[urgency=low]
border-color=#${B02}

[urgency=normal]
border-color=#${B0D}

[urgency=critical]
border-color=#${B08}
default-timeout=0
EOF

# --- Walker theme (GTK4 CSS) ---
WALKER_CSS="$HOME/.config/walker/themes/base16/style.css"
mkdir -p "$(dirname "$WALKER_CSS")"
[[ -L "$WALKER_CSS" ]] && rm "$WALKER_CSS"

cat > "$WALKER_CSS" << EOF
/* Auto-generated by tinty-hyprland-hook — do not edit */

@define-color walker_bg #${B00};
@define-color walker_bg_light #${B01};
@define-color walker_border #${B02};
@define-color walker_muted #${B03};
@define-color walker_fg #${B05};
@define-color walker_red #${B08};
@define-color walker_accent #${B0D};
@define-color walker_accent2 #${B0E};

* {
  all: unset;
  font-family: "JetBrainsMono Nerd Font";
}

scrollbar {
  opacity: 0;
}

.box-wrapper {
  background: alpha(@walker_bg, 0.95);
  padding: 16px;
  border: 1px solid @walker_border;
  border-radius: 0;
}

.preview-box,
.elephant-hint,
.placeholder {
  color: @walker_muted;
}

.search-container {
  border-radius: 0;
}

.input placeholder {
  opacity: 0.5;
}

.input selection {
  background: @walker_border;
}

.input {
  caret-color: @walker_fg;
  background: @walker_bg_light;
  padding: 10px;
  color: @walker_fg;
  border: 1px solid @walker_border;
  border-radius: 0;
  font-size: 14px;
}

.list {
  color: @walker_fg;
}

.item-box {
  padding: 8px 10px;
  border-radius: 0;
}

.item-quick-activation {
  background: alpha(@walker_accent, 0.15);
  border-radius: 0;
  padding: 8px;
}

child:selected .item-box,
row:selected .item-box {
  background: alpha(@walker_accent, 0.15);
  border-left: 2px solid @walker_accent;
}

.item-subtext {
  font-size: 12px;
  color: @walker_muted;
}

.providerlist .item-subtext {
  font-size: unset;
  opacity: 0.75;
}

.item-image-text {
  font-size: 28px;
}

.normal-icons {
  -gtk-icon-size: 16px;
}

.large-icons {
  -gtk-icon-size: 32px;
}

.preview {
  border: 1px solid @walker_border;
  border-radius: 0;
  color: @walker_fg;
}

.preview .large-icons {
  -gtk-icon-size: 64px;
}

.calc .item-text {
  font-size: 24px;
}

.symbols .item-image {
  font-size: 24px;
}

.todo.done .item-text-box {
  opacity: 0.25;
}

.todo.urgent {
  font-size: 24px;
}

.todo.active {
  font-weight: bold;
}

.bluetooth.disconnected {
  opacity: 0.5;
}

.keybinds {
  padding-top: 8px;
  border-top: 1px solid @walker_border;
  font-size: 12px;
  color: @walker_fg;
}

.keybind-button {
  opacity: 0.5;
}

.keybind-button:hover {
  opacity: 0.75;
}

.keybind-bind {
  text-transform: lowercase;
  opacity: 0.35;
}

.keybind-label {
  padding: 2px 4px;
  border-radius: 0;
  border: 1px solid @walker_muted;
}

.error {
  padding: 10px;
  background: @walker_red;
  color: @walker_fg;
}

:not(.calc).current {
  font-style: italic;
}

.preview-content.archlinuxpkgs,
.preview-content.dnfpackages {
  font-family: monospace;
}

popover {
  background: @walker_bg_light;
  border: 1px solid @walker_border;
  border-radius: 0;
  padding: 10px;
}
EOF

# Reload Hyprland config if running
if command -v hyprctl &> /dev/null; then
  hyprctl reload &> /dev/null
fi

# Reload mako if running
if command -v makoctl &> /dev/null; then
  makoctl reload &> /dev/null
fi
