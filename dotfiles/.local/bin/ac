#!/usr/bin/env bash
# Select a previous llm conversation to continue

mkdir -p "$HOME/.cache"
CID_FILE="$HOME/.cache/llm-conversation-id"

SELECTED=$(llm logs list -n 0 --json | \
  jq -r '
    group_by(.conversation_id) |
    map({
      conversation_id: .[0].conversation_id,
      conversation_name: .[0].conversation_name,
      last_interaction: (map(.datetime_utc) | max)
    }) |
    sort_by(.last_interaction) |
    reverse |
    .[] |
    "\(.conversation_id)\t\(.conversation_name)"
  ' | \
  fzf --with-nth=2 --delimiter=$'\t' \
      --preview 'llm logs list --cid {1} -t' \
      --preview-window=right:50%:wrap)

if [[ -n "$SELECTED" ]]; then
  CID=$(echo "$SELECTED" | cut -f1)
  echo "$CID" > "$CID_FILE"
  echo ""
  llm logs list --cid "$CID" | glow
  echo ""
  echo "Next 'a' command will continue this conversation."
fi
