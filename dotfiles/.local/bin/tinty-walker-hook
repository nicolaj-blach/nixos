#!/usr/bin/env bash
# Generate Walker base16 theme CSS from tinty base16 palette.
# Called as a tinty hook — palette is available via $TINTY_SCHEME_PALETTE_* env vars.

B00="${TINTY_SCHEME_PALETTE_BASE00_HEX_R}${TINTY_SCHEME_PALETTE_BASE00_HEX_G}${TINTY_SCHEME_PALETTE_BASE00_HEX_B}"
B01="${TINTY_SCHEME_PALETTE_BASE01_HEX_R}${TINTY_SCHEME_PALETTE_BASE01_HEX_G}${TINTY_SCHEME_PALETTE_BASE01_HEX_B}"
B02="${TINTY_SCHEME_PALETTE_BASE02_HEX_R}${TINTY_SCHEME_PALETTE_BASE02_HEX_G}${TINTY_SCHEME_PALETTE_BASE02_HEX_B}"
B03="${TINTY_SCHEME_PALETTE_BASE03_HEX_R}${TINTY_SCHEME_PALETTE_BASE03_HEX_G}${TINTY_SCHEME_PALETTE_BASE03_HEX_B}"
B05="${TINTY_SCHEME_PALETTE_BASE05_HEX_R}${TINTY_SCHEME_PALETTE_BASE05_HEX_G}${TINTY_SCHEME_PALETTE_BASE05_HEX_B}"
B08="${TINTY_SCHEME_PALETTE_BASE08_HEX_R}${TINTY_SCHEME_PALETTE_BASE08_HEX_G}${TINTY_SCHEME_PALETTE_BASE08_HEX_B}"
B0D="${TINTY_SCHEME_PALETTE_BASE0D_HEX_R}${TINTY_SCHEME_PALETTE_BASE0D_HEX_G}${TINTY_SCHEME_PALETTE_BASE0D_HEX_B}"
B0E="${TINTY_SCHEME_PALETTE_BASE0E_HEX_R}${TINTY_SCHEME_PALETTE_BASE0E_HEX_G}${TINTY_SCHEME_PALETTE_BASE0E_HEX_B}"

WALKER_CSS="$HOME/.config/walker/themes/base16/style.css"
mkdir -p "$(dirname "$WALKER_CSS")"
[[ -L "$WALKER_CSS" ]] && rm "$WALKER_CSS"

cat > "$WALKER_CSS" << EOF
/* Auto-generated by tinty-walker-hook — do not edit */

@define-color walker_bg #${B00};
@define-color walker_bg_light #${B01};
@define-color walker_border #${B02};
@define-color walker_muted #${B03};
@define-color walker_fg #${B05};
@define-color walker_red #${B08};
@define-color walker_accent #${B0D};
@define-color walker_accent2 #${B0E};

* {
  all: unset;
  font-family: "JetBrainsMono Nerd Font";
}

scrollbar {
  opacity: 0;
}

.box-wrapper {
  background: alpha(@walker_bg, 0.95);
  padding: 16px;
  border: 1px solid @walker_border;
  border-radius: 0;
}

.preview-box,
.elephant-hint,
.placeholder {
  color: @walker_muted;
}

.search-container {
  border-radius: 0;
}

.input placeholder {
  opacity: 0.5;
}

.input selection {
  background: @walker_border;
}

.input {
  caret-color: @walker_fg;
  background: @walker_bg_light;
  padding: 10px;
  color: @walker_fg;
  border: 1px solid @walker_border;
  border-radius: 0;
  font-size: 14px;
}

.list {
  color: @walker_fg;
}

.item-box {
  padding: 8px 10px;
  border-radius: 0;
}

.item-quick-activation {
  background: alpha(@walker_accent, 0.15);
  border-radius: 0;
  padding: 8px;
}

child:selected .item-box,
row:selected .item-box {
  background: alpha(@walker_accent, 0.15);
  border-left: 2px solid @walker_accent;
}

.item-subtext {
  font-size: 12px;
  color: @walker_muted;
}

.providerlist .item-subtext {
  font-size: unset;
  opacity: 0.75;
}

.item-image-text {
  font-size: 28px;
}

.normal-icons {
  -gtk-icon-size: 16px;
}

.large-icons {
  -gtk-icon-size: 32px;
}

.preview {
  border: 1px solid @walker_border;
  border-radius: 0;
  color: @walker_fg;
}

.preview .large-icons {
  -gtk-icon-size: 64px;
}

.calc .item-text {
  font-size: 24px;
}

.symbols .item-image {
  font-size: 24px;
}

.todo.done .item-text-box {
  opacity: 0.25;
}

.todo.urgent {
  font-size: 24px;
}

.todo.active {
  font-weight: bold;
}

.bluetooth.disconnected {
  opacity: 0.5;
}

.keybinds {
  padding-top: 8px;
  border-top: 1px solid @walker_border;
  font-size: 12px;
  color: @walker_fg;
}

.keybind-button {
  opacity: 0.5;
}

.keybind-button:hover {
  opacity: 0.75;
}

.keybind-bind {
  text-transform: lowercase;
  opacity: 0.35;
}

.keybind-label {
  padding: 2px 4px;
  border-radius: 0;
  border: 1px solid @walker_muted;
}

.error {
  padding: 10px;
  background: @walker_red;
  color: @walker_fg;
}

:not(.calc).current {
  font-style: italic;
}

.preview-content.archlinuxpkgs,
.preview-content.dnfpackages {
  font-family: monospace;
}

popover {
  background: @walker_bg_light;
  border: 1px solid @walker_border;
  border-radius: 0;
  padding: 10px;
}
EOF
