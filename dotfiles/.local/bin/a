#!/usr/bin/env bash
# Continue an llm conversation
# Uses stored conversation from 'ac' if set, otherwise continues most recent

LOGO="$HOME/nixos/assets/ansiLogoSmall.txt"
LOGO_LINES=8
CID_FILE="$HOME/.cache/llm-conversation-id"

# Hide cursor during animation
tput civis

# Print empty lines to reserve space for logo, then move back up
for ((i=0; i<LOGO_LINES; i++)); do echo; done
printf '\033[%dA' "$LOGO_LINES"

# Run tte animation in a loop in background subshell
(
  trap 'exit 0' TERM
  while true; do
    tput civis
    tte -i "$LOGO" --frame-rate 65 highlight 2>/dev/null &
    TTE_PID=$!
    wait $TTE_PID
    printf '\033[%dA' "$LOGO_LINES"
  done
) &
ANIM_PID=$!

cleanup() {
  # Kill the animation subshell and all its children
  pkill -P $ANIM_PID 2>/dev/null
  kill $ANIM_PID 2>/dev/null
  wait $ANIM_PID 2>/dev/null
  # Show cursor again
  tput cnorm
}
trap cleanup EXIT

# Run llm, capture output
if [[ -f "$CID_FILE" ]]; then
  CID=$(cat "$CID_FILE")
  OUTPUT=$(llm --cid "$CID" "$*" 2>&1)
else
  OUTPUT=$(llm -c "$*" 2>&1)
fi

# Stop animation
cleanup

# Clear the logo area
printf '\033[%dA\033[J' "$LOGO_LINES"

# Render response
echo "$OUTPUT" | glow
