#!/usr/bin/env bash
# Pretty-print NixOS generations with base16-onedark colors

# base16-onedark palette (ANSI escape codes)
reset=$'\e[0m'
dim=$'\e[2m'
bold=$'\e[1m'
blue=$'\e[38;2;97;175;239m'    # base0D
green=$'\e[38;2;152;195;121m'  # base0B
purple=$'\e[38;2;198;120;221m' # base0E
yellow=$'\e[38;2;229;192;123m' # base0A
fg=$'\e[38;2;171;178;191m'     # base05
comment=$'\e[38;2;84;88;98m'   # base03
cyan=$'\e[38;2;86;182;194m'    # base0C

# Header
printf "%s  %-4s  %-20s  %s%s\n" \
  "${blue}${bold}" "Gen" "Date" "Description${reset}"
printf "%s%s%s\n" \
  "${comment}" "$(printf '%.0s─' {1..60})" "${reset}"

# Collect all output, then print at once
raw=$(nixos-rebuild list-generations 2>/dev/null | tail -n +2)

output=""
while read -r line; do
  [[ -z "$line" ]] && continue

  gen=$(echo "$line" | awk '{print $1}')
  date=$(echo "$line" | awk '{print $2}')
  time=$(echo "$line" | awk '{print $3}')
  version=$(echo "$line" | awk '{print $4}')
  current=$(echo "$line" | awk '{print $NF}')

  # Replace underscores with spaces in version
  version="${version//_/ }"

  # Current marker
  if [[ "$current" == "True" ]]; then
    marker="${yellow}*${reset}"
    gen_color="${yellow}${bold}"
  else
    marker=" "
    gen_color="${fg}"
  fi

  output+="$(printf "%s %s%-4s${reset}  %s%s %s${reset}  %s%s${reset}" \
    "$marker" "$gen_color" "$gen" \
    "${cyan}" "$date" "$time" \
    "${green}" "$version")"$'\n'
done <<< "$raw"

printf "%s" "$output"
