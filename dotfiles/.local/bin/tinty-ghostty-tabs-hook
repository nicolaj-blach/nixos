#!/usr/bin/env bash
# Generate Ghostty GTK CSS for tabs from tinty base16 palette.
# Called as a tinty hook — palette is available via $TINTY_SCHEME_PALETTE_* env vars.

B00="${TINTY_SCHEME_PALETTE_BASE00_HEX_R}${TINTY_SCHEME_PALETTE_BASE00_HEX_G}${TINTY_SCHEME_PALETTE_BASE00_HEX_B}"
B01="${TINTY_SCHEME_PALETTE_BASE01_HEX_R}${TINTY_SCHEME_PALETTE_BASE01_HEX_G}${TINTY_SCHEME_PALETTE_BASE01_HEX_B}"
B02="${TINTY_SCHEME_PALETTE_BASE02_HEX_R}${TINTY_SCHEME_PALETTE_BASE02_HEX_G}${TINTY_SCHEME_PALETTE_BASE02_HEX_B}"
B03="${TINTY_SCHEME_PALETTE_BASE03_HEX_R}${TINTY_SCHEME_PALETTE_BASE03_HEX_G}${TINTY_SCHEME_PALETTE_BASE03_HEX_B}"
B05="${TINTY_SCHEME_PALETTE_BASE05_HEX_R}${TINTY_SCHEME_PALETTE_BASE05_HEX_G}${TINTY_SCHEME_PALETTE_BASE05_HEX_B}"
B0D="${TINTY_SCHEME_PALETTE_BASE0D_HEX_R}${TINTY_SCHEME_PALETTE_BASE0D_HEX_G}${TINTY_SCHEME_PALETTE_BASE0D_HEX_B}"

CSS_FILE="$HOME/.config/ghostty/tabs.css"
mkdir -p "$(dirname "$CSS_FILE")"
[[ -L "$CSS_FILE" ]] && rm "$CSS_FILE"

cat > "$CSS_FILE" << EOF
/* Auto-generated by tinty-ghostty-tabs-hook — do not edit */

/* Tab bar background */
.tab-bar, tabbar, notebook header {
  background-color: #${B00};
  border: none;
  box-shadow: none;
  min-height: 0;
  padding: 0;
}

/* All tabs */
.tab-bar tab, tabbar tab, notebook tab {
  background-color: #${B01};
  color: #${B03};
  border: none;
  border-radius: 0;
  margin: 0;
  padding: 2px 8px;
  min-height: 0;
}

/* Tab label */
.tab-bar tab label, tabbar tab label {
  padding: 0;
  margin: 0;
  font-family: "JetBrainsMono Nerd Font", monospace;
  font-size: 10pt;
}

/* Active/selected tab */
.tab-bar tab:checked, tabbar tab:checked,
.tab-bar tab:selected, tabbar tab:selected,
notebook tab:checked {
  background-color: #${B00};
  color: #${B05};
  border-bottom: 2px solid #${B0D};
}

/* Hovered tab */
.tab-bar tab:hover, tabbar tab:hover, notebook tab:hover {
  background-color: #${B02};
  color: #${B05};
}

/* Tab close button */
.tab-bar tab button, tabbar tab button {
  color: #${B03};
  border: none;
  background: transparent;
  border-radius: 0;
  min-height: 0;
  min-width: 0;
  padding: 0;
}

.tab-bar tab button:hover, tabbar tab button:hover {
  color: #${B05};
  background-color: #${B02};
}

/* Remove any rounded corners and extra spacing */
* {
  border-radius: 0;
}

tabbar, .tab-bar {
  min-height: 0;
}
EOF
