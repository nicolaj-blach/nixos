#!/usr/bin/env bash
# Generate Posting theme from tinty base16 palette.
# Called as a tinty hook — palette is available via $TINTY_SCHEME_PALETTE_* env vars.

B00="#${TINTY_SCHEME_PALETTE_BASE00_HEX_R}${TINTY_SCHEME_PALETTE_BASE00_HEX_G}${TINTY_SCHEME_PALETTE_BASE00_HEX_B}"
B01="#${TINTY_SCHEME_PALETTE_BASE01_HEX_R}${TINTY_SCHEME_PALETTE_BASE01_HEX_G}${TINTY_SCHEME_PALETTE_BASE01_HEX_B}"
B03="#${TINTY_SCHEME_PALETTE_BASE03_HEX_R}${TINTY_SCHEME_PALETTE_BASE03_HEX_G}${TINTY_SCHEME_PALETTE_BASE03_HEX_B}"
B05="#${TINTY_SCHEME_PALETTE_BASE05_HEX_R}${TINTY_SCHEME_PALETTE_BASE05_HEX_G}${TINTY_SCHEME_PALETTE_BASE05_HEX_B}"
B08="#${TINTY_SCHEME_PALETTE_BASE08_HEX_R}${TINTY_SCHEME_PALETTE_BASE08_HEX_G}${TINTY_SCHEME_PALETTE_BASE08_HEX_B}"
B09="#${TINTY_SCHEME_PALETTE_BASE09_HEX_R}${TINTY_SCHEME_PALETTE_BASE09_HEX_G}${TINTY_SCHEME_PALETTE_BASE09_HEX_B}"
B0A="#${TINTY_SCHEME_PALETTE_BASE0A_HEX_R}${TINTY_SCHEME_PALETTE_BASE0A_HEX_G}${TINTY_SCHEME_PALETTE_BASE0A_HEX_B}"
B0B="#${TINTY_SCHEME_PALETTE_BASE0B_HEX_R}${TINTY_SCHEME_PALETTE_BASE0B_HEX_G}${TINTY_SCHEME_PALETTE_BASE0B_HEX_B}"
B0C="#${TINTY_SCHEME_PALETTE_BASE0C_HEX_R}${TINTY_SCHEME_PALETTE_BASE0C_HEX_G}${TINTY_SCHEME_PALETTE_BASE0C_HEX_B}"
B0D="#${TINTY_SCHEME_PALETTE_BASE0D_HEX_R}${TINTY_SCHEME_PALETTE_BASE0D_HEX_G}${TINTY_SCHEME_PALETTE_BASE0D_HEX_B}"
B0E="#${TINTY_SCHEME_PALETTE_BASE0E_HEX_R}${TINTY_SCHEME_PALETTE_BASE0E_HEX_G}${TINTY_SCHEME_PALETTE_BASE0E_HEX_B}"

THEME_DIR="$HOME/.local/share/posting/themes"
mkdir -p "$THEME_DIR"

cat > "$THEME_DIR/base16.yaml" << EOF
# Auto-generated by tinty-posting-hook — do not edit
name: base16
description: Base16 theme generated by tinty

primary: '${B0D}'
secondary: '${B0E}'
accent: '${B0C}'
background: '${B00}'
surface: '${B01}'
error: '${B08}'
success: '${B0B}'
warning: '${B0A}'

syntax:
  json_key: '${B0E}'
  json_number: '${B09}'
  json_string: '${B0B}'
  json_boolean: '${B0C}'
  json_null: '${B03}'

url:
  base: '${B05}'
  protocol: '${B0D}'

text_area:
  cursor: '${B0D}'
  cursor_line: 'underline'
  selection: 'reverse'
  gutter: '${B03}'
  matched_bracket: '${B00} on ${B0D}'

method:
  get: '${B0D}'
  post: '${B0B}'
  put: '${B0A}'
  patch: '${B09}'
  delete: '${B08}'
  head: '${B0E}'
  options: '${B0C}'
EOF
