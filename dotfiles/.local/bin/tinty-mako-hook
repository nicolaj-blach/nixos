#!/usr/bin/env bash
# Generate mako colors file from tinty base16 palette.
# Called as a tinty hook — palette is available via $TINTY_SCHEME_PALETTE_* env vars.

B00="${TINTY_SCHEME_PALETTE_BASE00_HEX_R}${TINTY_SCHEME_PALETTE_BASE00_HEX_G}${TINTY_SCHEME_PALETTE_BASE00_HEX_B}"
B02="${TINTY_SCHEME_PALETTE_BASE02_HEX_R}${TINTY_SCHEME_PALETTE_BASE02_HEX_G}${TINTY_SCHEME_PALETTE_BASE02_HEX_B}"
B05="${TINTY_SCHEME_PALETTE_BASE05_HEX_R}${TINTY_SCHEME_PALETTE_BASE05_HEX_G}${TINTY_SCHEME_PALETTE_BASE05_HEX_B}"
B08="${TINTY_SCHEME_PALETTE_BASE08_HEX_R}${TINTY_SCHEME_PALETTE_BASE08_HEX_G}${TINTY_SCHEME_PALETTE_BASE08_HEX_B}"
B0D="${TINTY_SCHEME_PALETTE_BASE0D_HEX_R}${TINTY_SCHEME_PALETTE_BASE0D_HEX_G}${TINTY_SCHEME_PALETTE_BASE0D_HEX_B}"

MAKO_COLORS="$HOME/.config/mako/colors"
mkdir -p "$(dirname "$MAKO_COLORS")"
[[ -L "$MAKO_COLORS" ]] && rm "$MAKO_COLORS"

cat > "$MAKO_COLORS" << EOF
# Auto-generated by tinty-mako-hook — do not edit
background-color=#${B00}ee
text-color=#${B05}
border-color=#${B02}
progress-color=over #${B0D}

[urgency=low]
border-color=#${B02}

[urgency=normal]
border-color=#${B0D}

[urgency=critical]
border-color=#${B08}
EOF

if command -v makoctl &> /dev/null; then
  makoctl reload &> /dev/null
fi
