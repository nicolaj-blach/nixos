# Mako notification daemon config
# Colors are overwritten at runtime by tinty-hyprland-hook

# Layout
max-visible=3
sort=-time
layer=overlay
anchor=top-right
margin=20,20,0,0

# Appearance
font=JetBrainsMono Nerd Font 11
width=400
height=150
padding=16
border-size=1
border-radius=0
background-color=#282c34ee
text-color=#abb2bf
border-color=#3e4452
progress-color=over #61afef

# Format
format=<b>%s</b>\n<span size="small" color="#3e4452">────────────────────────────────</span>\n%b

# Behavior
default-timeout=5000
ignore-timeout=0
icons=1
max-icon-size=48
markup=1
actions=1

# Urgency overrides
[urgency=low]
border-color=#3e4452

[urgency=normal]
border-color=#61afef

[urgency=critical]
border-color=#e06c75
default-timeout=0
