# Mako notification daemon config

# Colors (generated by tinty-mako-hook)
include=~/.config/mako/colors

# Layout
max-visible=3
sort=-time
layer=overlay
anchor=top-right
margin=20,20,0,0

# Appearance
font=JetBrainsMono Nerd Font 11
width=400
height=150
padding=16
border-size=1
border-radius=0

# Behavior
default-timeout=5000
ignore-timeout=0
icons=1
max-icon-size=48
markup=1
actions=1

[urgency=critical]
default-timeout=0
