{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "display": {
        "separator": " "
    },
    "logo": {
        "source": "~/.config/fastfetch/logo.txt",
        "type": "file",
        "position": "top",
        "padding": {
            "top": 1,
            "left": 1,
            "right": 4
        }
    },
    "modules": [
        {
            "type": "custom",
            "format": "\u001b[90m┌──────────────────────Hardware──────────────────────┐"
        },
        {
            "type": "host",
            "key": "┌ 󰌢",
            "keyColor": "green",
            "format": "{vendor} {name}"
        },
        {
            "type": "cpu",
            "key": "├ 󰻠",
            "showPeCoreCount": true,
            "keyColor": "green"
        },
        {
            "type": "cpuusage",
            "key": "├ 󰓅 \u001b[0mCPU Usage",
            "keyColor": "green"
        },
        {
            "type": "gpu",
            "key": "├ 󰢮",
            "detectionMethod": "pci",
            "keyColor": "green"
        },
        {
            "type": "display",
            "key": "├ 󰍹",
            "keyColor": "green"
        },
        {
            "type": "disk",
            "key": "├ 󰋊",
            "keyColor": "green"
        },
        {
            "type": "memory",
            "key": "├ 󰑭",
            "keyColor": "green"
        },
        {
            "type": "battery",
            "key": "└ 󰁹",
            "keyColor": "green"
        },
        {
            "type": "custom",
            "format": "\u001b[90m├──────────────────────Software──────────────────────┤"
        },
        {
            "type": "os",
            "key": "┌ 󱄅",
            "keyColor": "yellow"
        },
        {
            "type": "kernel",
            "key": "├ 󰌽",
            "keyColor": "yellow"
        },
        {
            "type": "packages",
            "key": "├ 󰏖",
            "keyColor": "yellow"
        },
        {
            "type": "processes",
            "key": "├ 󰒓",
            "keyColor": "yellow"
        },
        {
            "type": "shell",
            "key": "├ 󰆍",
            "keyColor": "yellow"
        },
        {
            "type": "editor",
            "key": "├ 󰏫",
            "keyColor": "yellow"
        },
        {
            "type": "bootmgr",
            "key": "└ 󰒋",
            "keyColor": "yellow"
        },
        {
            "type": "custom",
            "format": "\u001b[90m├──────────────────────Desktop───────────────────────┤"
        },
        {
            "type": "wm",
            "key": "┌ 󰖲",
            "keyColor": "blue"
        },
        {
            "type": "wmtheme",
            "key": "├ 󰉼",
            "keyColor": "blue"
        },
        {
            "type": "command",
            "key": "├ 󰏘",
            "keyColor": "blue",
            "text": "tinty current"
        },
        {
            "type": "icons",
            "key": "├ 󰀻",
            "keyColor": "blue"
        },

        {
            "type": "terminalfont",
            "key": "├ 󰛖",
            "keyColor": "blue"
        },
        {
            "type": "terminal",
            "key": "└ 󰆍",
            "keyColor": "blue"
        },
        {
            "type": "custom",
            "format": "\u001b[90m└────────────────────────────────────────────────────┘"
        },
        {
            "type": "colors",
            "symbol": "block"
        }
    ]
}
